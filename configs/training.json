{
  "model": {
    "model_type": "quasegpt",
    "vocab_size": 2000,
    "block_size": 256,
    "n_embd": 384,
    "n_head": 6,
    "n_layer": 6,
    "dropout": 0.1,
    "bias": true,
    "tie_weights": true
  },
  "data_dir": "./data",
  "out_dir": "./model",
  "batch_size": 32,
  "max_steps": 5000,
  "learning_rate": 0.0003,
  "weight_decay": 0.1,
  "warmup_steps": 200,
  "eval_every": 500,
  "save_every": 1000,
  "device": "auto",
  "seed": 42
}
